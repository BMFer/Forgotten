{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "//note": "Database:ConnectionString MUST point at the SAME SQLite file the bot uses. Default assumes dotnet run from this project dir with the bot DB alongside.",
  "Database": {
    "ConnectionString": "Data Source=../Forgotten.Bot/forgotten.db",
    "BusyTimeoutMs": 5000
  },
  "WalletVerification": {
    "PublicBaseUrl": "https://localhost:7443",
    "Domain": "localhost",
    "SessionTtlSeconds": 900,
    "MaximumLinkedWallets": 5,
    "OneWalletPerIdentity": true,
    "TipLinkClientId": ""
  }
}
