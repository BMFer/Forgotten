# Copy to /etc/forgotten/forgotten.env on the server, fill in, then:
#   sudo chown forgotten:forgotten /etc/forgotten/forgotten.env && sudo chmod 600 /etc/forgotten/forgotten.env
# NEVER commit the real file. Env var names use the "Section__Key" convention.

# --- Discord ---
Discord__Token=REPLACE_WITH_BOT_TOKEN
# Optional: fast guild-scoped command registration during testing. Leave blank for global.
Discord__DevGuildId=
# Optional: holders-only role. When set, only members with this role can use /nft gallery and flex.
Discord__FlexRoleId=

# --- Solana (must be a DAS-capable provider, e.g. Helius — NOT a plain RPC) ---
Solana__DasEndpoint=https://mainnet.helius-rpc.com/?api-key=REPLACE_WITH_FRESH_KEY
Solana__Network=mainnet-beta

# --- Database (shared by both services) ---
Database__ConnectionString=Data Source=/var/lib/forgotten/forgotten.db

# --- Wallet verification (public HTTPS origin) ---
WalletVerification__PublicBaseUrl=https://verify.forgottennft.com
WalletVerification__Domain=verify.forgottennft.com
# Optional: enables the "Connect with TipLink" button (request a clientId from TipLink).
WalletVerification__TipLinkClientId=
